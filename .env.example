# Copy to .env and fill in. Every integration is optional: a missing key is logged and skipped, never a crash.

# --- LLM (Groq) ---
GROQ_API_KEY=
# Strong model for the extractor, conflict agent, review editor, ask, digest, and brief.
GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Fast small model for the normalizer.
GROQ_MODEL_FAST=llama-3.1-8b-instant
# Speech-to-text for audio uploads.
GROQ_MODEL_WHISPER=whisper-large-v3-turbo

# --- Demo safety net ---
# 1 = recorded model outputs for the seed demo inputs (and whenever the key is missing). Other input still goes to Groq.
DEMO_REPLAY=1
# Starting value of the demo clock after /api/demo/reset.
DEMO_CLOCK_START=2026-10-31T09:00:00

# --- Tracker: Notion (primary) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Tracker: GitHub Issues (fallback) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Reminders / heads-up messages ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DATABASE_URL=sqlite:///./data/quorum.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

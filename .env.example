# Copy to .env and fill in. Every integration is optional: a missing key is logged and skipped, never a crash.

# --- LLM (Groq) ---
GROQ_API_KEY=
# Chosen by the bake-off (backend/scripts/bakeoff_results.md).
# Strong model for the extractor, conflict agent, review editor, ask, digest, and brief.
GROQ_MODEL_STRONG=openai/gpt-oss-120b
# Fast small model for the normalizer.
GROQ_MODEL_FAST=qwen/qwen3.8-27b
# Reasoning effort for models that support it (gpt-oss: low|medium|high). Empty = model default.
GROQ_REASONING_STRONG=low
GROQ_REASONING_FAST=
# Per-call timeout and retries after malformed output / transient errors.
GROQ_TIMEOUT_S=30
GROQ_MAX_RETRIES=2
# With no GROQ_API_KEY, probe Groq at startup (the key may be a network secret injected by a proxy).
GROQ_AUTODETECT=1
# Speech-to-text for audio uploads.
GROQ_MODEL_WHISPER=whisper-large-v3-turbo

# --- Demo safety net ---
# 1 = recorded model outputs for the seed demo inputs (and whenever the key is missing). Other input still goes to Groq.
DEMO_REPLAY=1
# 1 = save live LLM answers as replay recordings (only when you ask for it).
QUORUM_RECORD=0
# Starting value of the demo clock after /api/demo/reset.
DEMO_CLOCK_START=2026-10-31T09:00:00
# Minimum time each agent shows as "working" in replay mode, so the live trace is watchable. 0 disables.
REPLAY_STEP_MS=700

# --- Tracker: Notion (primary) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Tracker: GitHub Issues (fallback) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Reminders / heads-up messages ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DATABASE_URL=sqlite:///./data/quorum.db
CHECKPOINT_DB=./data/checkpoints.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
